# 끝없는 수족관 — 환경 변수 예시. 복사해서 .env.local 로 사용하세요.

# 운영자 허용 목록 (앱인토스 배포용)
# 운영 콘솔(/admin)에 접속하면 "내 키"가 표시됩니다. 그 값을 여기에 쉼표로 넣으세요.
# 예: VITE_ADMIN_KEYS="toss:abcd1234...,toss:efgh5678..."
VITE_ADMIN_KEYS=""

# 로컬 개발용 운영자 패스프레이즈 (앱인토스 밖에서 /admin 잠금 해제용, 기본값: gorae)
VITE_ADMIN_KEY="gorae"

# 데이터 모드: 로컬 데모는 mock, 공유 서버는 supabase
VITE_API_MODE="mock"

# Supabase Project Settings → API에서 확인 (service_role 키는 절대 클라이언트에 넣지 않음)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# 카카오 디벨로퍼스 → 앱 → 플랫폼 키 → JavaScript 키
# Web 플랫폼 사이트 도메인에 https://endless-aquarium.vercel.app 등록 필요
VITE_KAKAO_JAVASCRIPT_KEY=""
